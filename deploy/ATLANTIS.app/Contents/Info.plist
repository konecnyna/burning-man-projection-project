<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Minimal app bundle that exists for exactly one reason: TCC.

      macOS attributes camera access to the "responsible process". Running the
      app from Terminal works because Terminal.app holds the grant and the
      python child inherits it. Under launchd there is no such parent -- the
      responsible process is the interpreter itself, com.apple.python3, which
      holds no grant and whose bundle declares no NSCameraUsageDescription, so
      macOS denies silently and never prompts.

      Launching through this bundle gives the kiosk its own TCC identity that
      CAN be prompted for and CAN hold a grant, so the camera keeps working
      when the machine boots into the app unattended.

      LSUIElement hides it from the Dock and app switcher; the fullscreen
      webview is the only thing the audience should ever see.
    -->
    <key>CFBundleIdentifier</key>       <string>xyz.atlantis.kiosk</string>
    <key>CFBundleName</key>             <string>ATLANTIS</string>
    <key>CFBundleDisplayName</key>      <string>ATLANTIS Kiosk</string>
    <key>CFBundleExecutable</key>       <string>atlantis</string>
    <key>CFBundlePackageType</key>      <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key> <string>6.0</string>
    <key>CFBundleShortVersionString</key>    <string>1.0</string>
    <key>CFBundleVersion</key>          <string>1</string>
    <key>LSMinimumSystemVersion</key>   <string>13.0</string>
    <key>LSUIElement</key>              <true/>
    <key>NSHighResolutionCapable</key>  <true/>
    <key>NSCameraUsageDescription</key>
    <string>ATLANTIS uses the camera to track hand movement. No video is recorded, stored, or transmitted — frames are processed in memory and discarded.</string>
</dict>
</plist>
