<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the ATLANTIS kiosk LaunchAgent.

  Do not install this file directly and do not hand-edit the installed copy.
  Run deploy/install-kiosk.sh, which renders the __PLACEHOLDERS__ below and
  writes the result to ~/Library/LaunchAgents/com.atlantis.kiosk.plist.

  Editing the installed copy means the next install overwrites your change.
  Change this template instead, then re-run the installer.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atlantis.kiosk</string>

    <!--
      Launch through the app bundle, not start-atlantis.sh directly.

      macOS attributes camera access to the "responsible process". Launching
      the script directly makes that com.apple.python3, which holds no TCC
      grant and declares no NSCameraUsageDescription, so the camera request is
      denied silently and never prompts -- the kiosk boots but never sees a
      hand. The bundle gives the kiosk an identity macOS will honour instead.

      It has to go through `open`, and the executable has to be the bundle,
      not a path inside it. Spawning the executable directly is what launchd
      would do on its own, and that yields no app identity at all -- the same
      dead end as launching the script. Only LaunchServices confers one.

      `-W` makes open wait for the app to exit rather than returning at once,
      which is what keeps KeepAlive meaningful: launchd sees a process that
      lives exactly as long as the kiosk does, and relaunches when it dies.

      Everything downstream (single-instance guard, venv, port, logging) is
      unchanged -- the applet just runs start-atlantis.sh and waits.

      Regenerate the bundle with deploy/build-app-bundle.sh; it is not a
      hand-written file and install-kiosk.sh rebuilds it every run.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-W</string>
        <string>__ATLANTIS_DIR__/deploy/ATLANTIS-Kiosk.app</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ATLANTIS_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ATLANTIS_PORT</key>
        <string>__ATLANTIS_PORT__</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
    </dict>

    <!-- Start at login. Auto-login makes login happen on every boot. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Relaunch whenever the process exits, for any reason. This is what
         makes a crash or a closed window self-heal instead of going dark. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Minimum seconds between relaunches, so a hard startup failure
         backs off instead of spinning. -->
    <key>ThrottleInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>__ATLANTIS_DIR__/logs/kiosk.out.log</string>
    <key>StandardErrorPath</key>
    <string>__ATLANTIS_DIR__/logs/kiosk.err.log</string>
</dict>
</plist>
